<Window x:Class="LAB9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабораторная работа №9" Height="550" Width="420"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="10">
        <GroupBox Header="1. Создание объекта" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Рубли:" Grid.Column="0"/>
                    <TextBox x:Name="txtRubles" Grid.Column="1"/>
                </Grid>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Копейки:" Grid.Column="0"/>
                    <TextBox x:Name="txtKopeks" Grid.Column="1"/>
                </Grid>
                <Button x:Name="btnCreate" Content="Создать" Click="btnCreate_Click" Margin="5" Height="30"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="2. Текущий объект" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="txtCurrent" Margin="5" FontWeight="Bold"/>
                <TextBlock x:Name="txtCopy" Margin="5" FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="3. Добавление копеек" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Количество:" Grid.Column="0"/>
                    <TextBox x:Name="txtAddKop" Grid.Column="1"/>
                </Grid>
                <Button x:Name="btnAdd" Content="Добавить" Click="btnAdd_Click" Margin="5" Height="30"/>
                <TextBlock x:Name="txtAddResult" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="4. Операторы ++ и --" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnInc" Content="++ (прибавить 1)" Grid.Column="0" Click="btnInc_Click" Margin="5" Height="30"/>
                <Button x:Name="btnDec" Content="-- (вычесть 1)" Grid.Column="1" Click="btnDec_Click" Margin="5" Height="30"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="5. Операторы + и -" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Количество копеек:" Grid.Column="0"/>
                    <TextBox x:Name="txtOperValue" Grid.Column="1"/>
                </Grid>
                <Button x:Name="btnPlus" Content="m + k" Click="btnPlus_Click" Margin="5,5,5,0" Height="30"/>
                <Button x:Name="btnMinus" Content="m - k" Click="btnMinus_Click" Margin="5,0,5,5" Height="30"/>
                <TextBlock x:Name="txtOperResult" Margin="5" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="6. Приведение типов" Margin="0,0,0,10">
            <StackPanel>
                <Button x:Name="btnCast" Content="Показать" Click="btnCast_Click" Margin="5" Height="30"/>
                <TextBlock x:Name="txtCast" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="txtError" Foreground="Red" Margin="5" TextWrapping="Wrap"/>
    </StackPanel>
</Window>